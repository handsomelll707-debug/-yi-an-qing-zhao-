<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:ns3="https://qingzhao.example/ontology#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"><owl:Ontology rdf:about="https://qingzhao.example/ontology" /><owl:Class rdf:about="https://qingzhao.example/ontology#Entity" /><owl:Class rdf:about="https://qingzhao.example/ontology#Relation" /><owl:ObjectProperty rdf:about="https://qingzhao.example/ontology#from" /><owl:ObjectProperty rdf:about="https://qingzhao.example/ontology#to" /><owl:DatatypeProperty rdf:about="https://qingzhao.example/ontology#relationLabel" /><owl:DatatypeProperty rdf:about="https://qingzhao.example/ontology#evidence" /><owl:DatatypeProperty rdf:about="https://qingzhao.example/ontology#sources" /><owl:DatatypeProperty rdf:about="https://qingzhao.example/ontology#entityType" /><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#li"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>李清照</rdfs:label><rdfs:comment>项目中心人物。生平节点与作品年代需要分别核验。</rdfs:comment><ns3:entityType>人物</ns3:entityType><ns3:sources>annotation,image2</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#zhao"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>赵明诚</rdfs:label><rdfs:comment>李清照配偶、共同收藏与校勘者；《金石录》作者。</rdfs:comment><ns3:entityType>人物</ns3:entityType><ns3:sources>markdown,image1</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#father"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>李格非</rdfs:label><rdfs:comment>李清照父亲。相关记载见所供年谱截图；具体履历待校。</rdfs:comment><ns3:entityType>人物</ns3:entityType><ns3:sources>image2</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#brother"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>李迒</rdfs:label><rdfs:comment>《金石录后序》提及其弟迒。</rdfs:comment><ns3:entityType>人物</ns3:entityType><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#xiang"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>项羽</rdfs:label><rdfs:comment>《夏日绝句》的咏写对象；不是李清照的现实交往人物。</rdfs:comment><ns3:entityType>诗中人物</ns3:entityType><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#jinshi"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>金石录后序</rdfs:label><rdfs:comment>李清照所作，记录收藏、共同生活与散失经历。</rdfs:comment><ns3:entityType>文献</ns3:entityType><ns3:sources>markdown,image0,image1</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#xia"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>夏日绝句</rdfs:label><rdfs:comment>当前正文来自辅助整理文本，版本与作年待核。</rdfs:comment><ns3:entityType>作品</ns3:entityType><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#nian"><rdf:type rdf:resource="https://qingzhao.example/ontology#Entity" /><rdfs:label>易安居士年谱</rdfs:label><rdfs:comment>所供民国年谱截图，仅覆盖部分年谱；不将截图当作完整年谱。</rdfs:comment><ns3:entityType>文献</ns3:entityType><ns3:sources>image2</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e1"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#li" /><ns3:to rdf:resource="https://qingzhao.example/ontology#zhao" /><ns3:relationLabel>配偶／共同收藏</ns3:relationLabel><ns3:evidence>《金石录后序》“始归赵氏”“同共勘校”等。</ns3:evidence><ns3:sources>markdown,image1</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e2"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#li" /><ns3:to rdf:resource="https://qingzhao.example/ontology#father" /><ns3:relationLabel>父女</ns3:relationLabel><ns3:evidence>所供年谱截图。</ns3:evidence><ns3:sources>image2</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e3"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#li" /><ns3:to rdf:resource="https://qingzhao.example/ontology#brother" /><ns3:relationLabel>姊弟</ns3:relationLabel><ns3:evidence>《后序》“有弟迒任敕局删定官”。</ns3:evidence><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e4"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#li" /><ns3:to rdf:resource="https://qingzhao.example/ontology#jinshi" /><ns3:relationLabel>撰写</ns3:relationLabel><ns3:evidence>《后序》末署“易安室题”。</ns3:evidence><ns3:sources>markdown,image1</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e5"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#zhao" /><ns3:to rdf:resource="https://qingzhao.example/ontology#jinshi" /><ns3:relationLabel>被记述</ns3:relationLabel><ns3:evidence>《后序》叙述赵明诚生平与收藏。</ns3:evidence><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e6"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#li" /><ns3:to rdf:resource="https://qingzhao.example/ontology#xia" /><ns3:relationLabel>署名作者</ns3:relationLabel><ns3:evidence>所供作品整理文件，待校注本复核。</ns3:evidence><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e7"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#xia" /><ns3:to rdf:resource="https://qingzhao.example/ontology#xiang" /><ns3:relationLabel>咏写</ns3:relationLabel><ns3:evidence>“至今思项羽”。不表示交游关系。</ns3:evidence><ns3:sources>markdown</ns3:sources></owl:NamedIndividual><owl:NamedIndividual rdf:about="https://qingzhao.example/ontology#e8"><rdf:type rdf:resource="https://qingzhao.example/ontology#Relation" /><ns3:from rdf:resource="https://qingzhao.example/ontology#nian" /><ns3:to rdf:resource="https://qingzhao.example/ontology#li" /><ns3:relationLabel>记述生平</ns3:relationLabel><ns3:evidence>所供年谱图像。</ns3:evidence><ns3:sources>image2</ns3:sources></owl:NamedIndividual></rdf:RDF>